# Homologação local — copie para deploy/.env.homolog e ajuste.
# NUNCA commitar o .env.homolog preenchido; NUNCA colar chaves de produção aqui.
# Sem ANTHROPIC_API_KEY o explicador cai no template Python (ok p/ homologar).
# Sem Stripe as rotas de billing respondem erro controlado (ok: cobrança NÃO se homologa aqui).

# DATABASE_URL vem do compose (aponta pro serviço db). NÃO defina aqui.
LEAKLAB_SECRET=homolog-local-apenas-nao-e-segredo-0123456789
ENVIRONMENT=development
ALLOWED_ORIGINS=*
PORT=5000

# Opcional — só se quiser homologar o caminho LLM de verdade (usa créditos!):
# ANTHROPIC_API_KEY=

# Solver: deixe vazio para NÃO solvar em homolog (fila enche e fica; é esperado).
# Apontar para o solver de prod (10.0.0.3) NÃO funciona daqui — rede privada do Hetzner.
# GTO_SOLVER_URL=
